# Environment variable template (NO secrets)
#
# Usage:
# - Local development: copy to `.env.local` and fill in values.
# - Production: set these variables in your hosting provider.

# =========================
# Public (exposed to browser)
# =========================
# Canonical site URL (SEO / absolute links). Optional; defaults to https://deltagreen.it in code.
NEXT_PUBLIC_SITE_URL=

# Base URL used by some scripts (optional; defaults to http://localhost:3000)
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Base URL used by Swagger/docs (optional; defaults to http://localhost:3000)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Dev-only locale switch ("it" by default, supports "en")
NEXT_PUBLIC_DEV_LOCALE=it

# Stripe publishable key (client-side)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Iubenda Cookie Policy ID (for external privacy/cookie policy links)
NEXT_PUBLIC_IUBENDA_POLICY_ID=

# Optional Mapbox token fallback (prefer MAPBOX_ACCESS_TOKEN below)
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=

# =========================
# Server-only (never expose)
# =========================
# Auth
JWT_SECRET=

# Database (use ONE of these, depending on your setup)
MONGO_URI=
MONGODB_URI=
DATABASE_URL=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Mapbox (used by /api/mapbox/geocode)
MAPBOX_ACCESS_TOKEN=

# Mailchimp (optional: newsletter / exports)
MAILCHIMP_API_KEY=
MAILCHIMP_SERVER_PREFIX=
MAILCHIMP_LIST_ID=
MAILCHIMP_FROM_EMAIL=

# Simple API secret used by admin Mailchimp export/stats endpoints
API_SECRET_KEY=

# =========================
# Flags / switches
# =========================
# If not set, mock products are enabled unless USE_MOCK_PRODUCTS is exactly "false"
USE_MOCK_PRODUCTS=

# Test-only DB seed endpoint guard (never enable in production)
ALLOW_TEST_DB_SEED=