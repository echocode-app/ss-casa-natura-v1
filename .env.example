# Environment variable template (NO secrets)
# Copy to .env.local and fill values.

# =========================
# App URLs
# =========================
NEXT_PUBLIC_SITE_URL=
SITE_URL=
NEXT_PUBLIC_SITE_NAME=

# =========================
# Auth
# =========================
JWT_SECRET=

# =========================
# MongoDB (primary key used in code)
# =========================
MONGODB_URI=

# =========================
# Stripe (Backend)
# =========================
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional live webhook secret
STRIPE_WEBHOOK_SECRET_LIVE=

# =========================
# Stripe (Frontend)
# =========================
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# =========================
# Admin
# =========================
ADMIN_EMAIL=

# =========================
# Mailchimp Marketing
# =========================
MAILCHIMP_API_KEY=
MAILCHIMP_SERVER_PREFIX=
MAILCHIMP_LIST_ID=

# =========================
# Mailchimp Transactional (Mandrill)
# =========================
MAILCHIMP_TRANSACTIONAL_API_KEY=
MAILCHIMP_FROM_EMAIL=

# =========================
# Contact
# =========================
CONTACT_EMAIL=

# =========================
# Locale
# =========================
NEXT_PUBLIC_DEV_LOCALE=it

# =========================
# Iubenda
# =========================
NEXT_PUBLIC_IUBENDA_ENABLED=true
NEXT_PUBLIC_IUBENDA_SITE_ID=
NEXT_PUBLIC_IUBENDA_COOKIE_POLICY_ID=
NEXT_PUBLIC_IUBENDA_POLICY_ID=

# =========================
# Cloudinary
# =========================
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# =========================
# Mapbox
# =========================
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=

# =========================
# Optional / legacy
# =========================
API_SECRET_KEY=
