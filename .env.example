# =========================
# Core
# =========================
MONGO_URI=your_mongo_uri_here
JWT_SECRET=your_jwt_secret_here

# =========================
# Stripe
# =========================
STRIPE_SECRET_KEY=your_stripe_secret_here
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret_here
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key_here

# =========================
# Mailchimp
# =========================
MAILCHIMP_API_KEY=your_mailchimp_api_key_here
MAILCHIMP_SERVER_PREFIX=usX
MAILCHIMP_LIST_ID=your_mailchimp_list_id_here
MAILCHIMP_FROM_EMAIL=your_mailchimp_from_email_here

# =========================
# Admin / Contact
# =========================
ADMIN_EMAIL=admin@example.com
CONTACT_EMAIL=contact@example.com
API_SECRET_KEY=your_secure_random_secret_for_api_endpoints

# For client-side (optional, only if needed in browser)
# NEXT_PUBLIC_API_SECRET_KEY=your_public_api_key_if_needed

# =========================
# App
# =========================
NEXT_PUBLIC_BASE_URL=http://localhost:3000
# NEXT_PUBLIC_SITE_URL=https://casanatura.it

# =========================
# Locale
# =========================
# NEXT_PUBLIC_DEV_LOCALE=en
NEXT_PUBLIC_DEV_LOCALE=it

# =========================
# Iubenda
# =========================
NEXT_PUBLIC_IUBENDA_ENABLED=true
# Iubenda Cookie Solution (required when NEXT_PUBLIC_IUBENDA_ENABLED=true)
# Get these values from your Iubenda dashboard
NEXT_PUBLIC_IUBENDA_SITE_ID=your_iubenda_site_id
NEXT_PUBLIC_IUBENDA_COOKIE_POLICY_ID=your_iubenda_cookie_policy_id

# Checkout address autocomplete (Mapbox Geocoding)
# Recommended: server-side token (keeps token off the client)
MAPBOX_ACCESS_TOKEN=
# Optional: public token for direct client-side usage
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=